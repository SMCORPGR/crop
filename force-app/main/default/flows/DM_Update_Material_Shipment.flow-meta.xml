    <decisions>
        <name>Received_in_Full</name>
        <label>Received in Full?</label>
        <locationX>506</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Shipment_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Full_Received</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.digitalm__DM_Received_in_Full__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.digitalm__DM_Total_Quantity_Received__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.DM_Quantity__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Received</targetReference>
            </connector>
            <label>Yes - Full Shipment</label>
        </rules>
        <rules>
            <name>Yes_Partial_Shipment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
