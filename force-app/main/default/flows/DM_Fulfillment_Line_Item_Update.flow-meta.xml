<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Updated_Line_Item</name>
        <label>Assign Updated Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Inventory_Num__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.DM_Inventory__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Inventory_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varToday</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Quantity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNewQuantity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Debit_Credit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCreditDebit</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Comment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Quantity Shipped updated</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Quantity_UOM__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.DM_Quantity_UOM__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objInventoryLineItem.DM_Reference_Transaction__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Updated_Line_Item</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Error_Message</name>
        <label>Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Inventory source cannot be changed for a Fulfillment Line Item. The Production source must be changed on the Sale Line Item record and a new Fulfillment record created.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Change_to</name>
        <label>Change to?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Inventory</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.digitalm__DM_Inventory__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message</targetReference>
            </connector>
            <label>Inventory</label>
        </rules>
        <rules>
            <name>Quantity_Shipped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.digitalm__DM_Quantity_Shipped__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Updated_Line_Item</targetReference>
            </connector>
            <label>Quantity Shipped</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varCreditDebit</name>
        <dataType>String</dataType>
        <expression>if({!varQuantityChange} &lt; 0, &quot;In&quot;, &quot;Out&quot;)</expression>
    </formulas>
    <formulas>
        <name>varNewQuantity</name>
        <dataType>Number</dataType>
        <expression>ABS({!varQuantityChange})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varQuantityChange</name>
        <dataType>Number</dataType>
        <expression>{!$Record.digitalm__DM_Quantity_Shipped__c} - {!$Record__Prior.digitalm__DM_Quantity_Shipped__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varToday</name>
        <dataType>Date</dataType>
        <expression>today()</expression>
    </formulas>
    <interviewLabel>DM Fulfillment Line Item - Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DM Fulfillment Line Item - Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Updated_Line_Item</name>
        <label>Create Updated Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>objInventoryLineItem</inputReference>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Change_to</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>DM_Quantity_Shipped__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DM_Inventory__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>DM_Fulfillment_Line_Item__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>objInventoryLineItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>DM_Inventory_Line_Item__c</objectType>
    </variables>
</Flow>
