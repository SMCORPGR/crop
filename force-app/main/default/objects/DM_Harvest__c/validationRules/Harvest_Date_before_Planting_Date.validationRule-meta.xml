<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Harvest_Date_before_Planting_Date</fullName>
    <active>true</active>
    <description>Harvest Date must be later that Planting Date</description>
    <errorConditionFormula>DM_Harvest_Date__c &lt;  DM_Production__r.DM_Planting_Date__c</errorConditionFormula>
    <errorDisplayField>DM_Harvest_Date__c</errorDisplayField>
    <errorMessage>Harvest Date must be after Planting Date</errorMessage>
</ValidationRule>
